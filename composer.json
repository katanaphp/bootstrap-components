{
    "name": "katanaphp/bootstrap-components",
    "description": "Bootstrap blade components for any PHP project",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Katanaphp\\BootstrapComponents\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "./tests"
        }
    },
    "authors": [
        {
            "name": "Sudhanshu R."
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9",
        "symfony/var-dumper": "^5",
        "symfony/css-selector": "^5",
        "symfony/dom-crawler": "^5"
    },
    "require": {
        "katanaphp/blade": "dev-master",
        "php": ">=8.0"
    }
}
